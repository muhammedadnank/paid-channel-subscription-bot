# Telegram Bot API Configuration
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
WEBHOOK_SECRET=your_super_secret_webhook_token_here
ADMIN_IDS=123456789,987654321

# MongoDB Atlas Database Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_NAME=paid_sub_db

# Payment Configuration
UPI_ID=merchant@upi

# Cron Job Security Token
CRON_SECRET=your_super_secret_cron_token_here

# Admin Dashboard Security (require ?key=<value> on /api/dashboard; leave unset to disable auth)
DASHBOARD_SECRET=your_super_secret_dashboard_key_here

# Optional: Admin activity log channel (sync results, etc.)
LOG_CHANNEL_ID=

# Optional: Fallback channel used by /subadd, /subextend, /subrem when no channel_id is passed
DEFAULT_CHANNEL_ID=

# Optional: Fallback plan/story name used by /subadd when none is passed
DEFAULT_STORY_NAME=
